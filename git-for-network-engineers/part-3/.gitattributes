# Normalize all text files to LF on commit, regardless of platform
* text=auto eol=lf

# Always treat these as text and convert line endings
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.md     text eol=lf

# Always binary (never touch line endings or attempt diffs)
*.png    binary
*.jpg    binary
*.pdf    binary
